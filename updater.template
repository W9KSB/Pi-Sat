#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
SERVICE_NAME="pi-sat"
LOCAL_UPDATER="${REPO_ROOT}/update_pi.sh"
UPDATER_TEMPLATE="${REPO_ROOT}/updater.template"

if [ "$(id -u)" -eq 0 ]; then
  echo "Run this updater as the normal Pi user, not with sudo."
  exit 1
fi

if ! command -v sudo >/dev/null 2>&1; then
  echo "sudo is required."
  exit 1
fi

if [ ! -d "${REPO_ROOT}/.git" ]; then
  echo "This updater must be run from an existing git checkout."
  exit 1
fi

if [ ! -f "${REPO_ROOT}/requirements.txt" ]; then
  echo "requirements.txt not found in ${REPO_ROOT}."
  exit 1
fi

echo "Updating Pi-Sat Controller in: ${REPO_ROOT}"

cd "${REPO_ROOT}"

service_stopped=0
restore_service_on_failure() {
  status=$?
  if [ "${status}" -ne 0 ] && [ "${service_stopped}" -eq 1 ]; then
    echo "Update failed after stopping ${SERVICE_NAME}; attempting to restart it."
    sudo systemctl start "${SERVICE_NAME}" || true
  fi
  trap - EXIT
  exit "${status}"
}
trap restore_service_on_failure EXIT

git fetch --all --prune
git reset --hard origin/main

# update_pi.sh is an ignored, locally generated copy of updater.template. If
# the repository changed the updater itself, refresh that copy and re-enter the
# update once so the new migration logic handles the rest of this run.
if [ "${PI_SAT_UPDATER_REEXEC:-0}" -eq 0 ] \
    && [ -f "${UPDATER_TEMPLATE}" ] \
    && ! cmp -s "${UPDATER_TEMPLATE}" "${LOCAL_UPDATER}"; then
  cp "${UPDATER_TEMPLATE}" "${LOCAL_UPDATER}"
  chmod +x "${LOCAL_UPDATER}"
  export PI_SAT_UPDATER_REEXEC=1
  exec "${LOCAL_UPDATER}"
fi

if [ ! -f bin/pi-sat-sstv-decoder ]; then
  echo "Missing bundled SSTV decoder: ${REPO_ROOT}/bin/pi-sat-sstv-decoder"
  exit 1
fi
chmod +x bin/pi-sat-sstv-decoder
if command -v file >/dev/null 2>&1; then
  file_output="$(file -b bin/pi-sat-sstv-decoder)"
  case "${file_output}" in
    *"ELF 64-bit"*"ARM aarch64"*) : ;;
    *) echo "Bundled SSTV decoder is not a 64-bit AArch64 ELF: ${file_output}"; exit 1 ;;
  esac
fi

sudo systemctl stop "${SERVICE_NAME}"
service_stopped=1
sudo usermod -aG dialout "$(id -un)"
sudo python3 -m pip install --break-system-packages -r requirements.txt
sudo systemctl daemon-reload
# Pi-Sat no longer runs a local STUN service. Retire the unit an earlier
# install added, and the coturn package it existed for, so the station stops
# listening on UDP 3478 and nothing reintroduces it.
if sudo systemctl list-unit-files | grep -q '^pi-sat-stun\.service'; then
  echo "Removing the retired local STUN service."
  sudo systemctl disable --now pi-sat-stun >/dev/null 2>&1 || true
  sudo rm -f /etc/systemd/system/pi-sat-stun.service
  sudo systemctl daemon-reload
fi
if dpkg -s coturn >/dev/null 2>&1; then
  echo "Removing coturn, which Pi-Sat installed only for that STUN service."
  sudo apt-get purge -y coturn >/dev/null 2>&1 || echo "coturn could not be removed automatically."
fi
sudo systemctl start "${SERVICE_NAME}"
service_stopped=0
trap - EXIT

echo ""
echo "Update complete."
echo "Service: sudo systemctl status ${SERVICE_NAME}"
echo "Logs:    journalctl -u ${SERVICE_NAME} -f"
